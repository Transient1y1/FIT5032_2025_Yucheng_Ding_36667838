rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function coordinator() { return signedIn() && request.auth.token.role in ['coordinator', 'admin']; }
    match /opportunities/{id} { allow read: if true; allow write: if coordinator(); }
    match /users/{id} { allow read: if coordinator() || (signedIn() && request.auth.uid == id); allow create: if signedIn() && request.auth.uid == id; allow update: if coordinator() || (signedIn() && request.auth.uid == id); }
    match /applications/{id} { allow read: if coordinator() || (signedIn() && resource.data.userId == request.auth.uid); allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update: if coordinator(); }
    match /ratings/{id} { allow read: if true; allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid; }
    match /bookings/{id} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow update, delete: if coordinator() || (signedIn() && resource.data.userId == request.auth.uid); }
  }
}

